{% liquid
  assign contribution_amount = closest.product.metafields.custom.contribution_amount
  assign contribution_rate = closest.product.metafields.custom.contribution_rate
  assign contribution_basis = closest.product.metafields.custom.contribution_basis.value
  assign impact_eligible = closest.product.metafields.custom.impact_eligible.value
%}

<aside class="raccoono-product-impact" {{ block.shopify_attributes }}>
  <div class="raccoono-product-impact__heading">
    {% render 'raccoono-icon', name: 'proof', class: 'raccoono-product-impact__icon' %}
    <strong>{{ block.settings.heading | escape }}</strong>
  </div>
  {% if impact_eligible and contribution_amount != blank %}
    <p>
      {{ block.settings.amount_prefix | escape }}
      {{ contribution_amount | metafield_tag }}
      {% if contribution_basis != blank %}— {{ contribution_basis | escape }}{% endif %}
    </p>
  {% elsif impact_eligible and contribution_rate != blank %}
    <p>
      {{ contribution_rate.value }} %
      {% if contribution_basis != blank %}— {{ contribution_basis | escape }}{% endif %}
    </p>
  {% else %}
    <p>{{ block.settings.pending_text | escape }}</p>
  {% endif %}
  {% if block.settings.link_label != blank %}
    <a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
  {% endif %}
</aside>

{% stylesheet %}
  .raccoono-product-impact {
    display: grid;
    gap: 0.8rem;
    width: 100%;
    padding: 1.6rem;
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 1.6rem 1.6rem 1.6rem 0.5rem;
    background: color-mix(in srgb, #2F5B43 9%, transparent);
  }

  .raccoono-product-impact__heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .raccoono-product-impact__icon {
    width: 2.4rem;
    height: 2.4rem;
    color: #2F5B43;
  }

  .raccoono-product-impact p {
    margin: 0;
    color: color-mix(in srgb, currentColor 74%, transparent);
    font-size: 1.4rem;
  }

  .raccoono-product-impact a {
    width: fit-content;
    font-weight: 750;
    text-underline-offset: 0.4rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Raccoono — Impact produit",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Contribution liée à ce produit" },
    { "type": "text", "id": "amount_prefix", "label": "Préfixe du montant", "default": "Montant reversé :" },
    { "type": "textarea", "id": "pending_text", "label": "Texte sans données", "default": "Les modalités de contribution de ce produit sont en cours de configuration. Consultez la page Impact avant toute décision." },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Voir les modalités et justificatifs" },
    { "type": "url", "id": "link", "label": "Lien vers la page Impact" }
  ],
  "presets": [
    { "name": "Raccoono — Impact produit" }
  ]
}
{% endschema %}
