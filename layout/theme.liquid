<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#FFFFFF">
    <meta name="color-scheme" content="light">

    {% render 'meta-tags' %}

    {% liquid
      assign body_font_semibold = settings.type_body_font | font_modify: 'weight', '600'
    %}
    <style>
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {% if body_font_semibold %}
        {{ body_font_semibold | font_face: font_display: 'swap' }}
      {% endif %}
      {{ settings.type_display_font | font_face: font_display: 'swap' }}
    </style>

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'homepage.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}
      {{ 'scroll-sequence-hero.css' | asset_url | stylesheet_tag }}
    {% else %}
      {{ 'storefront.css' | asset_url | stylesheet_tag }}
      {% if request.page_type == 'product' %}
        {{ 'product-page.css' | asset_url | stylesheet_tag }}
      {% endif %}
    {% endif %}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    {% if request.page_type == 'index' %}
      <script src="{{ 'raccoon-personalities.js' | asset_url }}" defer></script>
      <script src="{{ 'scroll-sequence-hero.js' | asset_url }}" defer></script>
    {% elsif request.page_type == 'product' %}
      <script src="{{ 'product-page.js' | asset_url }}" defer></script>
    {% endif %}

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ request.page_type | handle }} color-scheme--{{ settings.default_color_scheme }}{% if settings.underline_body_links %} links-underlined{% endif %}"
    data-motion="{{ settings.motion_level }}"
  >
    <a class="skip-link" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% render 'no-js-message' %}

    {% unless request.page_type == 'index' %}
      {% sections 'header-group' %}
    {% endunless %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% unless request.page_type == 'index' %}
      {% sections 'footer-group' %}
    {% endunless %}

    <div
      id="RaccoonoLiveRegion"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>
  </body>
</html>
