{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.mission.heading' | t
  endif

  assign link_label = section.settings.link_label
  if link_label == blank
    assign link_label = 'sections.mission.action' | t
  endif
%}

<section
  class="brand-mission section-spacing"
  data-section-id="{{ section.id }}"
  data-section-type="brand-mission"
>
  <div class="brand-mission__content container container--reading">
    {% if section.settings.eyebrow != blank %}
      <p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2>{{ heading | escape }}</h2>
    <div class="brand-mission__text rte">
      {% if section.settings.text != blank %}
        {{ section.settings.text }}
      {% else %}
        <p>{{ 'sections.mission.text_one' | t }}</p>
        <p>{{ 'sections.mission.text_two' | t }}</p>
      {% endif %}
    </div>
    {% if section.settings.link != blank %}
      {% render 'button',
        label: link_label,
        href: section.settings.link,
        variant: 'text',
        size: 'compact',
        icon: 'arrow-right'
      %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Mission de la marque",
  "tag": "section",
  "class": "section-brand-mission",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du lien"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien"
    }
  ],
  "presets": [
    {
      "name": "Mission de la marque"
    }
  ]
}
{% endschema %}
