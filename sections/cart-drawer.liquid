<cart-drawer
  id="CartDrawer"
  class="drawer cart-drawer"
  data-drawer
  aria-hidden="true"
  data-open-after-add="{{ settings.open_cart_drawer }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-threshold="{{ settings.free_shipping_threshold }}"
  data-empty-message="{{ 'sections.cart.empty' | t | escape }}"
  data-continue-message="{{ 'general.continue_shopping' | t | escape }}"
  data-continue-url="{{ routes.all_products_collection_url }}"
  data-checkout-url="/checkout"
  data-checkout-message="{{ 'sections.cart.checkout' | t | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-view-cart-message="{{ 'sections.cart.view_cart' | t | escape }}"
  data-subtotal-message="{{ 'sections.cart.subtotal' | t | escape }}"
  data-tax-message="{{ 'sections.cart.taxes' | t | escape }}"
  data-remove-message="{{ 'sections.cart.remove' | t | escape }}"
  data-quantity-message="{{ 'products.product.quantity' | t | escape }}"
  data-increase-message="{{ 'sections.cart.increase' | t | escape }}"
  data-decrease-message="{{ 'sections.cart.decrease' | t | escape }}"
  data-updated-message="{{ 'sections.cart.updated' | t | escape }}"
  data-error-message="{{ 'sections.cart.error' | t | escape }}"
  data-shipping-unlocked="{{ 'sections.cart.shipping_unlocked' | t | escape }}"
  data-shipping-remaining="{{ 'sections.cart.shipping_remaining' | t | escape }}"
>
  <div class="drawer__panel" data-cart-panel role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div class="drawer__header">
      <h2 id="CartDrawerTitle">{{ 'sections.cart.title' | t }}</h2>
      <button class="icon-button" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="cart-drawer__content" data-cart-content>
      {% if cart.item_count == 0 %}
        <div class="cart-empty">
          <p>{{ 'sections.cart.empty' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {% else %}
        <div class="cart-items">
          {% for item in cart.items %}
            <article class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                {% if item.image %}{{ item.image | image_url: width: 192 | image_tag: width: 96, height: 96, loading: 'lazy', alt: item.product.title }}{% endif %}
              </a>
              <div class="cart-item__content">
                <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
                {% unless item.product.has_only_default_variant %}<p class="cart-item__variant">{{ item.variant.title }}</p>{% endunless %}
                <span>{{ item.final_line_price | money }}</span>
                <div class="quantity">
                  <button type="button" data-cart-quantity data-line="{{ forloop.index }}" data-delta="-1" aria-label="{{ 'sections.cart.decrease' | t }}">−</button>
                  <input data-line-input="{{ forloop.index }}" value="{{ item.quantity }}" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}" readonly>
                  <button type="button" data-cart-quantity data-line="{{ forloop.index }}" data-delta="1" aria-label="{{ 'sections.cart.increase' | t }}">+</button>
                  <button class="cart-item__remove" type="button" data-cart-remove data-line="{{ forloop.index }}">{{ 'sections.cart.remove' | t }}</button>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
        <div class="cart-footer">
          <div class="cart-subtotal"><strong>{{ 'sections.cart.subtotal' | t }}</strong><strong>{{ cart.total_price | money }}</strong></div>
          <p class="muted">{{ 'sections.cart.taxes' | t }}</p>
          <a class="button" href="/checkout">{{ 'sections.cart.checkout' | t }}</a>
          <a href="{{ routes.cart_url }}">{{ 'sections.cart.view_cart' | t }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</cart-drawer>

{% stylesheet %}
  .cart-drawer.drawer{justify-content:flex-end}
  .cart-drawer .drawer__panel{max-width:440px}
  .cart-drawer .drawer__header{position:sticky;z-index:2;top:0;background:var(--color-bg)}
  .cart-drawer__content{display:flex;min-height:calc(100% - 72px);flex-direction:column}
  .cart-items{padding:0 1.25rem}
  .cart-item{display:grid;grid-template-columns:96px 1fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid var(--color-border)}
  .cart-item__image{overflow:hidden;border-radius:10px;background:var(--color-surface)}
  .cart-item__image img{width:96px;height:96px;object-fit:cover}
  .cart-item__content>a{text-decoration:none}
  .cart-item__variant{margin:.2rem 0;color:var(--color-muted);font-size:.85rem}
  .quantity{display:flex;align-items:center;gap:.4rem;margin-top:.65rem}
  .quantity button,.quantity input{width:34px;height:34px;border:1px solid var(--color-border);background:#fff;text-align:center}
  .quantity button{cursor:pointer}
  .quantity input{width:42px}
  .quantity .cart-item__remove{width:auto;margin-left:auto;padding-inline:.25rem;border:0;background:transparent;text-decoration:underline}
  .cart-footer{display:grid;gap:.75rem;margin-top:auto;padding:1.25rem;border-top:1px solid var(--color-border)}
  .cart-subtotal{display:flex;justify-content:space-between;font-size:1.1rem}
  .cart-empty{margin:auto;padding:3rem 1.25rem;text-align:center}
  .shipping-progress{padding:1rem 1.25rem}
  .shipping-progress p{font-size:.88rem}
  .shipping-progress>span{display:block;height:7px;overflow:hidden;border-radius:99px;background:var(--color-border)}
  .shipping-progress i{display:block;height:100%;border-radius:inherit;background:var(--color-accent-secondary)}
{% endstylesheet %}

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
