<section class="collection-showcase section">
  <div class="page-width">
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="collection-showcase__grid collection-showcase__grid--{{ section.settings.layout }}">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign title = block.settings.title | default: collection.title
          assign link = block.settings.link | default: collection.url
          assign image_alt = image.alt | default: title
        %}
        <a class="collection-card" href="{{ link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <div class="collection-card__media media">
            {% render 'responsive-image', image: image, sizes: '(min-width: 750px) 33vw, 80vw', loading: 'lazy', alt: image_alt, placeholder: 'collection-2' %}
          </div>
          <div class="collection-card__content">
            <h3>{{ title | default: 'Collection title — replace' }}</h3>
            {% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle }}</p>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .collection-showcase__grid{display:grid;gap:1rem}
  .collection-card{position:relative;color:inherit;text-decoration:none}
  .collection-card__media{aspect-ratio:4/3}
  .collection-card__media img{transition:transform .5s ease}
  .collection-card:hover img{transform:scale(1.04)}
  .collection-card__content{padding:1rem .15rem}
  .collection-card__content h3{margin:0}
  .collection-card__content p{margin:.25rem 0 0;color:var(--color-muted)}
  .collection-showcase__grid--overlay .collection-card__content{position:absolute;inset:auto 1rem 1rem;padding:1.25rem;border-radius:var(--radius);background:color-mix(in srgb,var(--color-bg) 88%,transparent);backdrop-filter:blur(10px)}
  @media(min-width:750px){.collection-showcase__grid{grid-template-columns:repeat(3,1fr)}.collection-showcase__grid--mosaic{grid-template-columns:1.5fr 1fr}.collection-showcase__grid--mosaic .collection-card:first-child{grid-row:span 2}.collection-showcase__grid--mosaic .collection-card:first-child .collection-card__media{height:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection showcase",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse by mood" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections with their own energy" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "standard", "label": "Text below" },
        { "value": "overlay", "label": "Text overlay" },
        { "value": "mosaic", "label": "Editorial mosaic" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Temporary collection note" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection showcase",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
