{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.comparison.heading' | t
  endif

  assign first_column = section.settings.feature_heading
  if first_column == blank
    assign first_column = 'sections.comparison.feature_column' | t
  endif

  assign brand_column = section.settings.brand_heading
  if brand_column == blank
    assign brand_column = shop.name
  endif

  assign other_column = section.settings.other_heading
  if other_column == blank
    assign other_column = 'sections.comparison.other_column' | t
  endif

  assign yes_label = 'sections.comparison.yes' | t
%}

<section
  class="comparison section-spacing"
  data-section-id="{{ section.id }}"
  data-section-type="comparison-table"
>
  <div class="container container--standard">
    <div class="section-heading section-heading--center">
      <h2>{{ heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    <div class="comparison__scroll" tabindex="0" role="region" aria-label="{{ heading | escape }}">
      <table class="comparison__table">
        <thead>
          <tr>
            <th scope="col">{{ first_column | escape }}</th>
            <th scope="col" class="comparison__brand-column">{{ brand_column | escape }}</th>
            <th scope="col">{{ other_column | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              <td class="comparison__brand-column">
                {% if block.settings.brand_value %}
                  {% render 'icon',
                    name: 'check',
                    size: 18,
                    title: yes_label
                  %}
                {% else %}
                  <span aria-label="{{ 'sections.comparison.no' | t }}">—</span>
                {% endif %}
              </td>
              <td>
                {% if block.settings.other_value %}
                  {% render 'icon',
                    name: 'check',
                    size: 18,
                    title: yes_label
                  %}
                {% else %}
                  <span aria-label="{{ 'sections.comparison.no' | t }}">—</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tableau comparatif",
  "tag": "section",
  "class": "section-comparison-table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Titre de la première colonne"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Titre de la colonne Raccoono"
    },
    {
      "type": "text",
      "id": "other_heading",
      "label": "Titre de la troisième colonne"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Critère"
        },
        {
          "type": "checkbox",
          "id": "brand_value",
          "label": "Coche dans la colonne Raccoono",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "other_value",
          "label": "Coche dans la troisième colonne",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Tableau comparatif",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
