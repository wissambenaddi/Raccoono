{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.featured_collection.heading' | t
  endif

  assign view_all_label = section.settings.view_all_label
  if view_all_label == blank
    assign view_all_label = 'sections.featured_collection.view_all' | t
  endif

  assign view_all_url = routes.all_products_collection_url
  if section.settings.collection != blank
    assign view_all_url = section.settings.collection.url
  endif
%}

<section
  class="featured-collection section-spacing"
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection"
>
  <div class="container">
    <div class="section-heading section-heading--inline">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ heading | escape }}</h2>
      </div>
      {% if section.settings.show_view_all %}
        {% render 'button',
          label: view_all_label,
          href: view_all_url,
          variant: 'text',
          size: 'compact',
          icon: 'arrow-right'
        %}
      {% endif %}
    </div>

    <div class="product-grid">
      {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, show_badges: section.settings.show_badges %}
        {% endfor %}
      {% else %}
        {% for item in (1..section.settings.products_to_show) %}
          {% assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 %}
          {% render 'product-card', placeholder_index: placeholder_index %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produits en vedette",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le lien vers la collection",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Libellé du lien"
    }
  ],
  "presets": [
    {
      "name": "Produits en vedette"
    }
  ]
}
{% endschema %}
