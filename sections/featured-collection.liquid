<section class="featured-collection section">
  <div class="page-width">
    <div class="section-heading">
      <div class="section-heading__copy">
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}
      </div>
      {% if section.settings.collection != blank %}<a class="button button--secondary visually-hidden-mobile" href="{{ section.settings.collection.url }}">{{ section.settings.link_label }}</a>{% endif %}
    </div>
    <div class="product-grid{% if section.settings.mobile_scroll %} product-grid--scroll{% endif %}">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, show_quick_add: section.settings.quick_add, image_ratio: section.settings.image_ratio %}
        {% else %}
          <p>{{ 'sections.featured_collection.empty' | t }}</p>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <article class="product-card">
            <div class="product-card__media media" style="--ratio:{{ section.settings.image_ratio }}">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__info"><div><h3>{{ 'sections.featured_collection.placeholder_title' | t }}</h3><span>{{ 0 | money }}</span></div></div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .product-card__media{display:block;aspect-ratio:var(--ratio);border-radius:var(--radius)}
  .product-card__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .35s ease,transform .45s ease}
  .product-card__image--secondary{opacity:0}
  .product-card__media:hover .product-card__image--primary{opacity:0}
  .product-card__media:hover .product-card__image--secondary{opacity:1}
  .product-card__media:hover img{transform:scale(1.025)}
  .product-card__badges{position:absolute;z-index:2;top:.75rem;left:.75rem;display:flex;gap:.35rem}
  .product-card__info{display:flex;align-items:start;justify-content:space-between;gap:.75rem;padding:.9rem .15rem}
  .product-card__info h3{margin:0 0 .3rem;font-family:var(--font-body);font-size:.95rem;line-height:1.3}
  .product-card__info h3 a{text-decoration:none}
  .product-card__quick-add{border:1px solid var(--color-border);border-radius:50%;background:#fff}
  .price{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.9rem}
  .price__compare{color:var(--color-muted)}
  @media(max-width:749px){.product-grid--scroll{display:grid;grid-auto-flow:column;grid-auto-columns:78%;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory}.product-grid--scroll>*{scroll-snap-align:start}}
  @media(min-width:750px){.product-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem}}
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected for now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the current favourites" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>Temporary introduction — connect a collection and replace this copy.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "View all" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 8 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "0.8", "label": "Portrait" },
        { "value": "1.25", "label": "Landscape" }
      ],
      "default": "1"
    },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add", "default": true },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Horizontal scroll on mobile", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
