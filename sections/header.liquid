<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}{% if section.settings.transparent %} site-header--transparent{% endif %}" data-site-header>
  <div class="site-header__inner page-width">
    <button id="MobileMenuButton" class="icon-button mobile-only" type="button" data-drawer-open="MobileMenu" aria-label="{{ 'sections.header.open_menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>
    <a class="site-header__logo" href="{{ routes.root_url }}" style="--logo-width:{{ settings.logo_width }}px">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 520 | image_tag: widths: '120, 180, 260, 360, 520', alt: shop.name }}
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>
    <nav class="site-header__nav visually-hidden-mobile" aria-label="{{ 'sections.header.primary_navigation' | t }}">
      <ul>
        {% for link in section.settings.menu.links %}
          <li>
            {% if link.links != blank %}
              <details>
                <summary>{{ link.title }}{% render 'icon', name: 'chevron' %}</summary>
                <ul class="site-header__submenu">
                  {% for child_link in link.links %}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">{% render 'icon', name: 'search' %}</a>
      {% endif %}
      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a class="icon-button visually-hidden-mobile" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">{% render 'icon', name: 'account' %}</a>
      {% endif %}
      <button id="CartButton" class="icon-button cart-button" type="button" data-drawer-open="CartDrawer" aria-label="{{ 'sections.cart.open' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<aside id="MobileMenu" class="drawer drawer--left" data-drawer aria-hidden="true">
  <div class="drawer__panel">
    <div class="drawer__header">
      <strong>{{ 'sections.header.menu' | t }}</strong>
      <button class="icon-button" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav class="mobile-nav" aria-label="{{ 'sections.header.mobile_navigation' | t }}">
      <ul>
        {% for link in section.settings.menu.links %}
          <li>
            {% if link.links != blank %}
              <details>
                <summary>{{ link.title }}</summary>
                <ul>
                  {% for child_link in link.links %}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</aside>

{% stylesheet %}
  .site-header{position:relative;z-index:40;border-bottom:1px solid var(--color-border);background:var(--color-bg);transition:background .2s ease,box-shadow .2s ease}
  .site-header--sticky{position:sticky;top:0}
  .site-header--transparent:not(.is-scrolled){border-color:transparent;background:color-mix(in srgb,var(--color-bg) 82%,transparent);backdrop-filter:blur(12px)}
  .site-header.is-scrolled{box-shadow:0 8px 32px rgba(19,34,29,.08)}
  .site-header__inner{display:grid;min-height:72px;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem}
  .site-header__logo{display:inline-flex;width:min(var(--logo-width),100%);align-items:center;justify-self:center;font-family:var(--font-heading);font-size:1.35rem;font-weight:800;text-decoration:none}
  .site-header__logo img{width:100%}
  .site-header__nav{justify-self:center}
  .site-header__nav>ul,.site-header__submenu,.mobile-nav ul{margin:0;padding:0;list-style:none}
  .site-header__nav>ul{display:flex;align-items:center;gap:1.6rem}
  .site-header__nav a,.site-header__nav summary{font-size:.92rem;font-weight:650;text-decoration:none;cursor:pointer}
  .site-header__nav summary{display:flex;align-items:center;gap:.25rem;list-style:none}
  .site-header__nav summary svg{width:13px;transform:rotate(90deg)}
  .site-header__nav details{position:relative}
  .site-header__submenu{position:absolute;top:calc(100% + 1rem);left:-1rem;min-width:220px;padding:.75rem;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-bg);box-shadow:0 20px 50px rgba(19,34,29,.12)}
  .site-header__submenu a{display:block;padding:.65rem .75rem;border-radius:8px}
  .site-header__submenu a:hover{background:var(--color-surface)}
  .site-header__actions{display:flex;align-items:center;justify-self:end}
  .cart-button{position:relative}
  .cart-count{position:absolute;top:3px;right:2px;display:grid;min-width:18px;height:18px;padding:0 4px;place-items:center;border-radius:999px;background:var(--color-accent);color:#fff;font-size:.66rem}
  .drawer{position:fixed;z-index:100;inset:0;display:flex;justify-content:flex-end;background:rgba(7,27,51,.48);opacity:0;pointer-events:none;transition:opacity .25s ease}
  .drawer--left{justify-content:flex-start}
  .drawer.is-open{opacity:1;pointer-events:auto}
  .drawer__panel{width:min(92vw,440px);height:100%;overflow:auto;background:var(--color-bg);transform:translateX(100%);transition:transform .25s ease}
  .drawer--left .drawer__panel{transform:translateX(-100%)}
  .drawer.is-open .drawer__panel{transform:none}
  .drawer__header{display:flex;min-height:72px;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border)}
  .mobile-nav{padding:1rem 1.25rem}
  .mobile-nav>ul>li{border-bottom:1px solid var(--color-border)}
  .mobile-nav a,.mobile-nav summary{display:block;padding:1rem 0;font-weight:700;text-decoration:none}
  .mobile-nav summary{cursor:pointer}
  .mobile-nav ul ul{padding-left:1rem}
  @media(min-width:750px){.site-header__inner{grid-template-columns:auto 1fr auto}.site-header__logo{justify-self:start}}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "transparent", "label": "Translucent over content", "default": false },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show customer account", "default": true }
  ],
  "presets": [{ "name": "Header" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
