{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.image_text.heading' | t
  endif

  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'sections.image_text.action' | t
  endif
%}

<section
  class="image-with-text image-with-text--{{ section.settings.image_position }} section-spacing"
  data-section-id="{{ section.id }}"
  data-section-type="image-with-text"
>
  <div class="image-with-text__grid container container--standard">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        {% render 'responsive-image',
          image: section.settings.image,
          alt: section.settings.image_alt,
          widths: '400, 600, 800, 1000, 1200, 1400',
          sizes: '(min-width: 750px) 48vw, 100vw',
          loading: 'lazy',
          aspect_ratio: '4 / 3'
        %}
      {% else %}
        <div class="image-with-text__placeholder" aria-hidden="true">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="image-with-text__content">
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2>{{ heading | escape }}</h2>
      <div class="image-with-text__text rte">
        {% if section.settings.text != blank %}
          {{ section.settings.text }}
        {% else %}
          <p>{{ 'sections.image_text.text' | t }}</p>
        {% endif %}
      </div>
      {% if section.settings.button_link != blank %}
        {% render 'button',
          label: button_label,
          href: section.settings.button_link,
          variant: 'primary',
          size: 'compact'
        %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image avec texte",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image ou illustration"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l’image sur desktop",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Image avec texte"
    }
  ]
}
{% endschema %}
