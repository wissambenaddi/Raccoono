<section class="storefront-section">
  <div class="container container--compact">
    <header class="storefront-heading storefront-heading--center">
      <p class="section-eyebrow">{{ 'customers.activate.eyebrow' | t }}</p>
      <h1>{{ 'customers.activate.title' | t }}</h1>
      <p>{{ 'customers.activate.text' | t }}</p>
    </header>

    {% form 'activate_customer_password', class: 'storefront-form' %}
      {% if form.errors %}
        <div class="form-status form-status--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <div class="field">
        <label for="ActivatePassword">{{ 'customers.fields.password' | t }}</label>
        <input
          id="ActivatePassword"
          type="password"
          name="customer[password]"
          autocomplete="new-password"
          required
        >
      </div>
      <div class="field">
        <label for="ActivatePasswordConfirmation">{{ 'customers.fields.password_confirmation' | t }}</label>
        <input
          id="ActivatePasswordConfirmation"
          type="password"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
        >
      </div>
      <div class="storefront-form__actions">
        <button class="button button--primary button--standard" type="submit">
          {{ 'customers.activate.submit' | t }}
        </button>
        <button class="button button--secondary button--standard" type="submit" name="decline">
          {{ 'customers.activate.decline' | t }}
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Activation du compte",
  "settings": []
}
{% endschema %}
