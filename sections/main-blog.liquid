<section class="storefront-section">
  <div class="container">
    <header class="storefront-heading">
      <p class="section-eyebrow">{{ 'templates.blog.eyebrow' | t }}</p>
      <h1>{{ blog.title | escape }}</h1>
    </header>

    {% paginate blog.articles by section.settings.articles_per_page %}
      {% if blog.articles_count > 0 %}
        <div class="article-grid">
          {% for article in blog.articles %}
            <article class="article-card">
              <a class="article-card__media" href="{{ article.url }}">
                {% if article.image != blank %}
                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      loading: 'lazy',
                      alt: article.image.alt
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </a>
              <div class="article-card__content">
                <p>{{ article.published_at | date: '%d/%m/%Y' }}</p>
                <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                {% if article.excerpt != blank %}
                  <div class="rte">{{ article.excerpt }}</div>
                {% else %}
                  <p>{{ article.content | strip_html | truncatewords: 28 }}</p>
                {% endif %}
                <a href="{{ article.url }}">{{ 'templates.blog.read_more' | t }}</a>
              </div>
            </article>
          {% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% else %}
        <div class="storefront-empty">
          <p>{{ 'templates.blog.empty' | t }}</p>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog principal",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles par page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ]
}
{% endschema %}
