{% assign continue_shopping_label = 'general.continue_shopping' | t %}

<section class="storefront-section">
  <div class="container container--standard">
    <header class="storefront-heading">
      <p class="section-eyebrow">{{ 'templates.cart.eyebrow' | t }}</p>
      <h1>{{ 'templates.cart.title' | t }}</h1>
    </header>

    {% if cart.item_count > 0 %}
      <form class="cart-form" action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-items">
          {% for item in cart.items %}
            <article class="cart-item">
              <a class="cart-item__media" href="{{ item.url }}">
                {% if item.image != blank %}
                  {{
                    item.image
                    | image_url: width: 320
                    | image_tag:
                      widths: '120, 180, 240, 320',
                      sizes: '120px',
                      loading: 'lazy',
                      alt: item.image.alt
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>

              <div class="cart-item__content">
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                {% unless item.variant.title == 'Default Title' %}
                  <p>{{ item.variant.title | escape }}</p>
                {% endunless %}
                <p>{{ item.final_price | money }}</p>
                {% for property in item.properties %}
                  {% assign first_character = property.first | slice: 0 %}
                  {% if property.last != blank and first_character != '_' %}
                    <p>{{ property.first | escape }}: {{ property.last | escape }}</p>
                  {% endif %}
                {% endfor %}
              </div>

              <div class="cart-item__quantity field">
                <label for="CartQuantity-{{ item.key }}">
                  {{ 'templates.cart.quantity' | t }}
                </label>
                <input
                  id="CartQuantity-{{ item.key }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  inputmode="numeric"
                >
              </div>

              <div class="cart-item__total">
                <strong>{{ item.final_line_price | money }}</strong>
                <a href="{{ item.url_to_remove }}">{{ 'templates.cart.remove' | t }}</a>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if section.settings.show_note %}
          <div class="field cart-form__note">
            <label for="CartNote">{{ 'templates.cart.note' | t }}</label>
            <textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea>
          </div>
        {% endif %}

        <div class="cart-summary">
          {% if cart.cart_level_discount_applications.size > 0 %}
            <ul role="list">
              {% for discount in cart.cart_level_discount_applications %}
                <li>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
              {% endfor %}
            </ul>
          {% endif %}
          <p>
            <span>{{ 'templates.cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </p>
          <small>{{ 'templates.cart.taxes_shipping' | t }}</small>
          <div class="cart-summary__actions">
            <button class="button button--secondary button--standard" type="submit" name="update">
              {{ 'templates.cart.update' | t }}
            </button>
            <button class="button button--primary button--standard" type="submit" name="checkout">
              {{ 'templates.cart.checkout' | t }}
            </button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="storefront-empty">
        <p>{{ 'templates.cart.empty' | t }}</p>
        {% render 'button',
          label: continue_shopping_label,
          href: routes.all_products_collection_url,
          variant: 'primary'
        %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Panier principal",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Afficher la note de commande",
      "default": true
    }
  ]
}
{% endschema %}
