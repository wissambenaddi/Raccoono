{% liquid
  assign selected_variant = product.selected_or_first_available_variant
%}
<section class="main-product section">
  <div class="page-width product-layout">
    <div class="product-gallery">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          {% assign media_alt = media.alt | default: product.title %}
          <div class="product-gallery__item media" id="Media-{{ section.id }}-{{ media.id }}">
            {% case media.media_type %}
              {% when 'image' %}
                {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 58vw, 100vw', loading: 'lazy', alt: media_alt %}
              {% when 'video' %}
                {{ media | video_tag: controls: true, preload: 'metadata' }}
              {% when 'external_video' %}
                {{ media | external_video_tag }}
              {% when 'model' %}
                {{ media | model_viewer_tag }}
            {% endcase %}
          </div>
        {% endfor %}
      {% else %}
        <div class="product-gallery__item media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {% endif %}
    </div>
    <div class="product-details">
      {% if product.vendor != blank %}<p class="eyebrow">{{ product.vendor }}</p>{% endif %}
      <h1>{{ product.title }}</h1>
      <div class="product-details__price" data-product-price>{{ selected_variant.price | money }}</div>
      {% if selected_variant.compare_at_price > selected_variant.price %}<s>{{ selected_variant.compare_at_price | money }}</s>{% endif %}
      <product-form
        data-url="{{ product.url }}"
        data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
        data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
        data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
        data-success-message="{{ 'products.product.added' | t | escape }}"
        data-error-message="{{ 'products.product.error' | t | escape }}"
      >
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {% unless product.has_only_default_variant %}
            <div class="product-options">
              {% for option in product.options_with_values %}
                <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                <select id="Option-{{ section.id }}-{{ forloop.index0 }}" data-option-select>
                  {% for value in option.values %}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              {% endfor %}
            </div>
          {% endunless %}
          <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <input id="Quantity-{{ section.id }}" class="product-quantity" type="number" name="quantity" value="1" min="1">
          <button class="button product-submit" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
            <span>{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
          {% if section.settings.show_dynamic_checkout and selected_variant.available %}<div class="dynamic-checkout">{{ form | payment_button }}</div>{% endif %}
          <p data-product-error role="alert" hidden></p>
          <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
        {% endform %}
      </product-form>
      <div class="product-description rte">{{ product.description }}</div>
      <div class="product-accordions">
        {% for block in section.blocks %}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }}<span>+</span></summary>
            <div class="rte">{{ block.settings.content }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>

{% stylesheet %}
  .product-layout{display:grid;gap:2rem}
  .product-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}
  .product-gallery__item{aspect-ratio:1}
  .product-gallery__item:first-child{grid-column:1/-1}
  .product-gallery video,.product-gallery iframe,.product-gallery model-viewer{width:100%;height:100%}
  .product-details h1{font-size:clamp(2.2rem,5vw,4.5rem)}
  .product-details__price{font-size:1.3rem;font-weight:750}
  .product-details form{display:grid;gap:.75rem;margin:2rem 0}
  .product-options{display:grid;gap:.55rem}
  .product-options select,.product-quantity{min-height:48px;padding:0 .8rem;border:1px solid var(--color-border);border-radius:8px;background:#fff}
  .product-quantity{width:88px}
  .product-submit{width:100%}
  .product-description{margin-top:2rem}
  .product-accordions{margin-top:2rem}
  .product-accordions details{border-top:1px solid var(--color-border)}
  .product-accordions summary{display:flex;min-height:58px;align-items:center;justify-content:space-between;cursor:pointer;list-style:none}
  .product-accordions details>div{padding-bottom:1.25rem}
  @media(min-width:990px){.product-layout{grid-template-columns:minmax(0,1.2fr) minmax(360px,.8fr);gap:clamp(3rem,7vw,7rem)}.product-details{position:sticky;top:100px;align-self:start}}
{% endstylesheet %}

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout", "default": false }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Replace with accurate product information.</p>" }
      ]
    }
  ]
}
{% endschema %}
