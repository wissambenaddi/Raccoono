{% liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_form_id = 'ProductForm-' | append: section.id
  assign breadcrumb_collection = collection | default: product.collections.first
  assign compare_price = selected_variant.compare_at_price
  assign is_on_sale = false
  if compare_price > selected_variant.price
    assign is_on_sale = true
  endif
%}

<product-page
  class="product-page"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-price-regular-label="{{ 'products.price.regular' | t | escape }}"
  data-price-sale-label="{{ 'products.price.sale' | t | escape }}"
>
  <div class="container container--product">
    <nav class="product-breadcrumb" aria-label="{{ 'templates.product.breadcrumb' | t | escape }}">
      <a href="{{ routes.root_url }}">{{ 'templates.product.home' | t }}</a>
      <span aria-hidden="true">/</span>
      {% if breadcrumb_collection != blank %}
        <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a>
        <span aria-hidden="true">/</span>
      {% endif %}
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="main-product">
      <div class="main-product__gallery-column">
        {% render 'product-media-gallery',
          product: product,
          selected_variant: selected_variant,
          section_id: section.id,
          media_fit: section.settings.media_fit
        %}
      </div>

      <div class="main-product__details">
        {% if section.settings.show_vendor and product.vendor != blank %}
          <p class="main-product__vendor">{{ product.vendor | escape }}</p>
        {% endif %}

        <h1>{{ product.title | escape }}</h1>

        <div
          class="main-product__price price{% if is_on_sale %} price--sale{% endif %}"
          data-product-price
          aria-live="polite"
        >
          <span class="visually-hidden" data-compare-label {% unless is_on_sale %}hidden{% endunless %}>
            {{ 'products.price.regular' | t }}
          </span>
          <s class="price__compare" data-compare-price {% unless is_on_sale %}hidden{% endunless %}>
            {% if is_on_sale %}{{ compare_price | money }}{% endif %}
          </s>
          <span class="visually-hidden">{{ 'products.price.sale' | t }}</span>
          <span class="main-product__current-price" data-current-price>{{ selected_variant.price | money }}</span>
        </div>

        <div
          class="main-product__unit-price"
          data-unit-price
          {% if selected_variant.unit_price_measurement == blank %}
            hidden
          {% endif %}
        >
          {% if selected_variant.unit_price_measurement != blank %}
            {{ selected_variant.unit_price | money }} /
            {% if selected_variant.unit_price_measurement.reference_value != 1 %}
              {{ selected_variant.unit_price_measurement.reference_value }}
            {% endif %}
            {{ selected_variant.unit_price_measurement.reference_unit }}
          {% endif %}
        </div>

        {% form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' %}
          {% if product.has_only_default_variant %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-select>
          {% else %}
            {% render 'product-variant-picker',
              product: product,
              selected_variant: selected_variant,
              section_id: section.id
            %}
          {% endif %}

          {% render 'product-buy-buttons',
            selected_variant: selected_variant,
            form: form,
            section_id: section.id,
            show_dynamic_checkout: section.settings.show_dynamic_checkout,
            show_sku: section.settings.show_sku
          %}
        {% endform %}

        {% if section.settings.show_reassurance %}
          {% render 'product-reassurance' %}
        {% endif %}

        {% for block in section.blocks %}
          <div class="main-product__app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="product-details">
      {% if section.settings.show_description and product.description != blank %}
        <details class="product-details__item" {% unless section.settings.collapse_description %}open{% endunless %}>
          <summary>
            <span>{{ 'templates.product.description' | t }}</span>
            {% render 'icon', name: 'chevron-down', size: 20 %}
          </summary>
          <div class="product-details__content rte storefront-rte">
            {{ product.description }}
          </div>
        </details>
      {% endif %}

      <details class="product-details__item">
        <summary>
          <span>{{ 'templates.product.shipping_details_title' | t }}</span>
          {% render 'icon', name: 'chevron-down', size: 20 %}
        </summary>
        <div class="product-details__content rte">
          <p>{{ 'templates.product.shipping_details_text' | t }}</p>
        </div>
      </details>

      <details class="product-details__item">
        <summary>
          <span>{{ 'templates.product.commitment_title' | t }}</span>
          {% render 'icon', name: 'chevron-down', size: 20 %}
        </summary>
        <div class="product-details__content rte">
          <p>{{ 'templates.product.commitment_text' | t }}</p>
        </div>
      </details>
    </div>
  </div>

  <script type="application/json" data-product-variants>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | money | json }},
          "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "unitPrice": {% if variant.unit_price_measurement != blank %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
          "unitReferenceValue": {% if variant.unit_price_measurement != blank %}{{ variant.unit_price_measurement.reference_value | json }}{% else %}null{% endif %},
          "unitReferenceUnit": {% if variant.unit_price_measurement != blank %}{{ variant.unit_price_measurement.reference_unit | json }}{% else %}null{% endif %},
          "featuredMediaId": {% if variant.featured_media != blank %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},
          "sku": {{ variant.sku | json }},
          "inventoryQuantity": {{ variant.inventory_quantity | json }},
          "inventoryManaged": {% if variant.inventory_management != blank %}true{% else %}false{% endif %},
          "inventoryPolicy": {{ variant.inventory_policy | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</product-page>

{{ product | structured_data }}

{% schema %}
{
  "name": "Produit principal",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher la marque",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Afficher la référence",
      "default": true
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Ajustement des médias",
      "options": [
        {
          "value": "contain",
          "label": "Image entière"
        },
        {
          "value": "cover",
          "label": "Remplir le cadre"
        }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Afficher la description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collapse_description",
      "label": "Replier la description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Afficher l’achat express",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reassurance",
      "label": "Afficher la réassurance",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
