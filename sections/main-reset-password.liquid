{% assign reset_label = 'customers.reset.submit' | t %}

<section class="storefront-section">
  <div class="container container--compact">
    <header class="storefront-heading storefront-heading--center">
      <p class="section-eyebrow">{{ 'customers.reset.eyebrow' | t }}</p>
      <h1>{{ 'customers.reset.title' | t }}</h1>
      <p>{{ 'customers.reset.text' | t }}</p>
    </header>

    {% form 'reset_customer_password', class: 'storefront-form' %}
      {% if form.errors %}
        <div class="form-status form-status--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <div class="field">
        <label for="ResetPassword">{{ 'customers.fields.password' | t }}</label>
        <input
          id="ResetPassword"
          type="password"
          name="customer[password]"
          autocomplete="new-password"
          required
        >
      </div>
      <div class="field">
        <label for="ResetPasswordConfirmation">{{ 'customers.fields.password_confirmation' | t }}</label>
        <input
          id="ResetPasswordConfirmation"
          type="password"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
        >
      </div>
      {% render 'button',
        label: reset_label,
        type: 'submit',
        variant: 'primary',
        full_width: true
      %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Nouveau mot de passe",
  "settings": []
}
{% endschema %}
