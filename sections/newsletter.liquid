<section class="newsletter section" style="--newsletter-bg:{{ section.settings.background }};--newsletter-text:{{ section.settings.text_color }}">
  <div class="page-width newsletter__inner">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
      <div class="newsletter__field">
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'newsletter.placeholder' | t }}" autocorrect="off" autocapitalize="off" autocomplete="email" required>
        <button class="button button--accent" type="submit">{{ section.settings.button_label }}</button>
      </div>
      {% if section.settings.legal != blank %}<p class="newsletter__legal">{{ section.settings.legal }}</p>{% endif %}
      {% if form.posted_successfully? %}<p role="status">{{ 'newsletter.success' | t }}</p>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .newsletter{background:var(--newsletter-bg);color:var(--newsletter-text)}
  .newsletter__inner{display:grid;gap:2rem;align-items:center}
  .newsletter__form label{display:block;margin-bottom:.5rem;font-weight:750}
  .newsletter__field{display:flex;flex-wrap:wrap;gap:.75rem}
  .newsletter__field input{min-width:220px;min-height:50px;flex:1;padding:0 1rem;border:1px solid var(--color-border);border-radius:999px}
  .newsletter__legal{margin-top:.65rem;font-size:.75rem;opacity:.75}
  @media(min-width:750px){.newsletter__inner{grid-template-columns:1fr 1fr;gap:5rem}}
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Worth opening" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New ideas, quiet launches, zero noise" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Temporary newsletter invitation. Explain what subscribers will actually receive.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Join the list" },
    { "type": "text", "id": "legal", "label": "Legal text", "default": "Replace with your consent and privacy wording." },
    { "type": "color", "id": "background", "label": "Background", "default": "#4ED7C8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#071B33" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
