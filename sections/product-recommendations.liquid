{% liquid
  assign recommendations_heading = section.settings.heading
  if recommendations_heading == blank
    assign recommendations_heading = 'templates.product.related_products' | t
  endif
%}

<product-recommendations
  class="product-recommendations"
  data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <section class="product-recommendations__section" aria-labelledby="ProductRecommendationsHeading-{{ section.id }}">
      <div class="container container--product">
        <header class="product-recommendations__header">
          <p class="section-eyebrow">{{ 'templates.product.related_eyebrow' | t }}</p>
          <h2 id="ProductRecommendationsHeading-{{ section.id }}">{{ recommendations_heading | escape }}</h2>
        </header>

        <div class="product-grid product-recommendations__grid">
          {% for recommendation in recommendations.products %}
            {% render 'product-card', product: recommendation, show_badges: true %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
</product-recommendations>

{% schema %}
{
  "name": "Produits recommandés",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
