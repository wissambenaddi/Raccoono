{% liquid
  assign contribution_configured = section.settings.contribution_verified
  assign contribution_amount = section.settings.contribution_amount_minor | default: 0
  assign cumulative_amount = section.settings.cumulative_amount_minor | default: 0
%}

<section
  class="raccoono-impact"
  style="
    --impact-bg: {{ section.settings.background }};
    --impact-panel: {{ section.settings.panel_color }};
    --impact-color: {{ section.settings.text_color }};
    --impact-accent: {{ section.settings.accent_color }};
  "
  aria-labelledby="ImpactTitle-{{ section.id }}"
>
  <div class="raccoono-impact__inner">
    <header class="raccoono-impact__hero">
      <div class="raccoono-impact__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="raccoono-impact__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h1 id="ImpactTitle-{{ section.id }}">{{ section.settings.heading }}</h1>
        {% if section.settings.introduction != blank %}
          <div class="rte">{{ section.settings.introduction }}</div>
        {% endif %}
        {% unless contribution_configured %}
          <p class="raccoono-impact__warning" role="note">
            {% render 'raccoono-icon', name: 'ledger', class: 'raccoono-impact__warning-icon' %}
            {{ section.settings.temporary_notice | escape }}
          </p>
        {% endunless %}
      </div>
      <div class="raccoono-impact__visual">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '500, 750, 1000, 1400',
              sizes: '(min-width: 990px) 44vw, 100vw',
              loading: 'eager',
              class: 'raccoono-impact__image'
          }}
        {% else %}
          <img
            class="raccoono-impact__image"
            src="{{ 'raccoono-forest-mission-v2.webp' | asset_url }}"
            width="1448"
            height="1086"
            loading="eager"
            alt=""
          >
        {% endif %}
      </div>
    </header>

    <div class="raccoono-impact__facts" aria-label="{{ section.settings.facts_label | escape }}">
      <article>
        <p>{{ section.settings.contribution_label | escape }}</p>
        {% if contribution_configured and section.settings.contribution_mode == 'amount' %}
          <strong>{{ contribution_amount | money_with_currency }}</strong>
        {% elsif contribution_configured and section.settings.contribution_mode == 'rate' %}
          <strong>{{ section.settings.contribution_rate }} %</strong>
        {% else %}
          <strong>{{ section.settings.pending_label | escape }}</strong>
        {% endif %}
        <small>{{ section.settings.calculation_basis | escape }}</small>
      </article>
      <article>
        <p>{{ section.settings.period_label | escape }}</p>
        <strong>{{ section.settings.period | escape }}</strong>
        <small>{{ section.settings.eligible_products | escape }}</small>
      </article>
      <article>
        <p>{{ section.settings.partner_label | escape }}</p>
        <strong>{{ section.settings.partner_name | escape }}</strong>
        {% if section.settings.partner_link != blank %}
          <a href="{{ section.settings.partner_link }}">{{ section.settings.partner_link_label | escape }}</a>
        {% else %}
          <small>{{ section.settings.partner_pending | escape }}</small>
        {% endif %}
      </article>
      <article>
        <p>{{ section.settings.cumulative_label | escape }}</p>
        {% if contribution_configured and cumulative_amount > 0 %}
          <strong>{{ cumulative_amount | money_with_currency }}</strong>
        {% else %}
          <strong>{{ section.settings.pending_label | escape }}</strong>
        {% endif %}
        <small>{{ section.settings.last_payment_date | escape }}</small>
      </article>
    </div>

    <div class="raccoono-impact__explain">
      <div>
        <p class="raccoono-impact__eyebrow">{{ section.settings.mechanism_eyebrow | escape }}</p>
        <h2>{{ section.settings.mechanism_heading }}</h2>
      </div>
      <div class="raccoono-impact__explain-copy rte">
        {{ section.settings.mechanism_text }}
        {% if section.settings.limitations != blank %}
          <div class="raccoono-impact__limitations">
            <strong>{{ section.settings.limitations_label | escape }}</strong>
            {{ section.settings.limitations }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="raccoono-impact__records">
      {% for block in section.blocks %}
        <article class="raccoono-impact__record raccoono-impact__record--{{ block.type }}" {{ block.shopify_attributes }}>
          <p class="raccoono-impact__record-type">
            {% case block.type %}
              {% when 'project' %}Projet
              {% when 'payment' %}Versement
              {% when 'document' %}Justificatif
              {% when 'update' %}Mise à jour
              {% else %}Information
            {% endcase %}
          </p>
          <h3>{{ block.settings.title | escape }}</h3>
          {% if block.settings.date != blank %}
            <p class="raccoono-impact__date">{{ block.settings.date | escape }}</p>
          {% endif %}
          {% if block.type == 'payment' and block.settings.amount_minor > 0 %}
            <p class="raccoono-impact__amount">{{ block.settings.amount_minor | money_with_currency }}</p>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="rte">{{ block.settings.text }}</div>
          {% endif %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" {% if block.type == 'document' %}rel="noopener"{% endif %}>
              {{ block.settings.link_label | escape }}
              <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
          {% if block.settings.is_temporary %}
            <small class="raccoono-impact__temporary">Contenu temporaire à remplacer</small>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    <div class="raccoono-impact__definitions">
      <div>
        <p class="raccoono-impact__eyebrow">{{ section.settings.definitions_eyebrow | escape }}</p>
        <h2>{{ section.settings.definitions_heading }}</h2>
      </div>
      <dl>
        <div>
          <dt>{{ section.settings.planting_title | escape }}</dt>
          <dd>{{ section.settings.planting_text | escape }}</dd>
        </div>
        <div>
          <dt>{{ section.settings.regeneration_title | escape }}</dt>
          <dd>{{ section.settings.regeneration_text | escape }}</dd>
        </div>
        <div>
          <dt>{{ section.settings.restoration_title | escape }}</dt>
          <dd>{{ section.settings.restoration_text | escape }}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

{% stylesheet %}
  .raccoono-impact {
    background: var(--impact-bg);
    color: var(--impact-color);
  }

  .raccoono-impact__inner {
    padding: clamp(4rem, 7vw, 9rem) max(2rem, calc((100vw - 130rem) / 2)) clamp(7rem, 11vw, 13rem);
  }

  .raccoono-impact__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(36rem, 1fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 9rem);
  }

  .raccoono-impact__eyebrow,
  .raccoono-impact__hero h1,
  .raccoono-impact__explain h2,
  .raccoono-impact__definitions h2 {
    margin: 0;
  }

  .raccoono-impact__eyebrow {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .raccoono-impact__hero h1 {
    max-width: 12ch;
    margin-top: 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(5rem, 8vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .raccoono-impact__intro > .rte {
    max-width: 60ch;
    margin-top: 2rem;
    font-size: 1.7rem;
  }

  .raccoono-impact__warning {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 1.3rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--impact-accent) 45%, transparent);
    border-radius: 1.4rem;
    background: color-mix(in srgb, var(--impact-accent) 12%, transparent);
    font-size: 1.4rem;
  }

  .raccoono-impact__warning-icon {
    flex: 0 0 2.4rem;
    width: 2.4rem;
  }

  .raccoono-impact__visual {
    overflow: hidden;
    border-radius: 3rem 3rem 3rem 0.8rem;
    background: #F7F1E6;
  }

  .raccoono-impact__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .raccoono-impact__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(4rem, 7vw, 8rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 2.4rem;
    background: color-mix(in srgb, currentColor 16%, transparent);
  }

  .raccoono-impact__facts article {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 18rem;
    padding: 2.4rem;
    background: var(--impact-panel);
  }

  .raccoono-impact__facts p,
  .raccoono-impact__facts small,
  .raccoono-impact__facts strong {
    margin: 0;
  }

  .raccoono-impact__facts p {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .raccoono-impact__facts strong {
    font-family: var(--font-heading--family);
    font-size: clamp(2.3rem, 3vw, 3.4rem);
    line-height: 1;
  }

  .raccoono-impact__facts small {
    color: color-mix(in srgb, currentColor 67%, transparent);
    font-size: 1.3rem;
  }

  .raccoono-impact__explain,
  .raccoono-impact__definitions {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(32rem, 1fr);
    gap: clamp(3rem, 7vw, 9rem);
    margin-top: clamp(6rem, 10vw, 12rem);
  }

  .raccoono-impact__explain h2,
  .raccoono-impact__definitions h2 {
    max-width: 12ch;
    margin-top: 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(4rem, 6vw, 6.8rem);
    line-height: 0.95;
  }

  .raccoono-impact__explain-copy {
    font-size: 1.6rem;
  }

  .raccoono-impact__limitations {
    margin-top: 2rem;
    padding: 2rem;
    border-left: 0.4rem solid var(--impact-accent);
    background: color-mix(in srgb, var(--impact-accent) 10%, transparent);
  }

  .raccoono-impact__limitations strong {
    display: block;
    margin-bottom: 0.8rem;
  }

  .raccoono-impact__records {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
    margin-top: clamp(5rem, 8vw, 9rem);
  }

  .raccoono-impact__record {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 25rem;
    padding: 2.4rem;
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    border-radius: 2.2rem 2.2rem 2.2rem 0.6rem;
    background: var(--impact-panel);
  }

  .raccoono-impact__record > * {
    margin: 0;
  }

  .raccoono-impact__record-type,
  .raccoono-impact__date {
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .raccoono-impact__record h3 {
    font-family: var(--font-heading--family);
    font-size: 2.7rem;
    line-height: 1;
  }

  .raccoono-impact__amount {
    color: var(--impact-accent);
    font-size: 2.4rem;
    font-weight: 800;
  }

  .raccoono-impact__record a {
    margin-top: auto;
    font-weight: 750;
    text-underline-offset: 0.4rem;
  }

  .raccoono-impact__temporary {
    width: fit-content;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--impact-accent) 15%, transparent);
  }

  .raccoono-impact__definitions dl {
    display: grid;
    gap: 1px;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    border-radius: 2rem;
    background: color-mix(in srgb, currentColor 15%, transparent);
  }

  .raccoono-impact__definitions dl div {
    padding: 2.2rem;
    background: var(--impact-panel);
  }

  .raccoono-impact__definitions dt {
    font-family: var(--font-heading--family);
    font-size: 2.4rem;
  }

  .raccoono-impact__definitions dd {
    margin: 0.6rem 0 0;
    color: color-mix(in srgb, currentColor 72%, transparent);
  }

  @media (max-width: 989px) {
    .raccoono-impact__hero,
    .raccoono-impact__explain,
    .raccoono-impact__definitions {
      grid-template-columns: 1fr;
    }

    .raccoono-impact__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .raccoono-impact__records {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .raccoono-impact__facts,
    .raccoono-impact__records {
      grid-template-columns: 1fr;
    }

    .raccoono-impact__facts article {
      min-height: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Raccoono — Impact",
  "tag": "section",
  "class": "raccoono-section",
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre impact" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Des preuves, pas de grandes promesses." },
    { "type": "richtext", "id": "introduction", "label": "Introduction", "default": "<p>Cette page présente le mécanisme de contribution, les bénéficiaires, les versements et les limites de l’opération. Le raton aime les histoires. Ici, nous préférons surtout les preuves.</p>" },
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "checkbox", "id": "contribution_verified", "label": "Les données publiées sont vérifiées", "default": false },
    { "type": "text", "id": "temporary_notice", "label": "Avertissement temporaire", "default": "Configuration en cours : aucun montant ni partenaire n’est affirmé tant que ces informations ne sont pas validées." },
    { "type": "text", "id": "facts_label", "label": "Libellé accessible des chiffres", "default": "Informations de contribution" },
    { "type": "text", "id": "contribution_label", "label": "Libellé de la contribution", "default": "Contribution par produit éligible" },
    {
      "type": "select",
      "id": "contribution_mode",
      "label": "Mode de contribution",
      "options": [
        { "value": "none", "label": "Non configuré" },
        { "value": "amount", "label": "Montant fixe" },
        { "value": "rate", "label": "Pourcentage" }
      ],
      "default": "none"
    },
    { "type": "number", "id": "contribution_amount_minor", "label": "Montant fixe en unité mineure (ex. 250 = 2,50 €)", "default": 0 },
    { "type": "number", "id": "contribution_rate", "label": "Pourcentage reversé", "default": 0 },
    { "type": "text", "id": "calculation_basis", "label": "Base de calcul", "default": "Base de calcul à confirmer" },
    { "type": "text", "id": "period_label", "label": "Libellé de période", "default": "Période" },
    { "type": "text", "id": "period", "label": "Période", "default": "Dates à confirmer" },
    { "type": "text", "id": "eligible_products", "label": "Produits concernés", "default": "Produits éligibles à préciser" },
    { "type": "text", "id": "partner_label", "label": "Libellé du partenaire", "default": "Partenaire bénéficiaire" },
    { "type": "text", "id": "partner_name", "label": "Nom complet du partenaire", "default": "Partenaire à confirmer" },
    { "type": "url", "id": "partner_link", "label": "Lien vers le partenaire" },
    { "type": "text", "id": "partner_link_label", "label": "Libellé du lien partenaire", "default": "Consulter le site du partenaire" },
    { "type": "text", "id": "partner_pending", "label": "Texte si aucun lien", "default": "Lien à ajouter après validation" },
    { "type": "text", "id": "cumulative_label", "label": "Libellé du cumul", "default": "Montant cumulé versé" },
    { "type": "number", "id": "cumulative_amount_minor", "label": "Cumul en unité mineure", "default": 0 },
    { "type": "text", "id": "last_payment_date", "label": "Date du dernier versement", "default": "Aucun versement publié à ce jour" },
    { "type": "text", "id": "pending_label", "label": "Valeur en attente", "default": "À confirmer" },
    { "type": "text", "id": "mechanism_eyebrow", "label": "Sur-titre du mécanisme", "default": "Mécanisme" },
    { "type": "inline_richtext", "id": "mechanism_heading", "label": "Titre du mécanisme", "default": "Comment la contribution est calculée." },
    { "type": "richtext", "id": "mechanism_text", "label": "Explication du mécanisme", "default": "<p>Indiquez ici le montant ou le pourcentage, la base de calcul, la période, les produits éligibles, le calendrier de versement et le type d’action soutenue.</p>" },
    { "type": "text", "id": "limitations_label", "label": "Titre des limites", "default": "Limites et périmètre" },
    { "type": "richtext", "id": "limitations", "label": "Limites", "default": "<p>Précisez ce que la contribution finance réellement et ce qu’elle ne permet pas d’affirmer. Aucun achat ne doit être présenté comme réparant à lui seul les dégâts d’un incendie.</p>" },
    { "type": "text", "id": "definitions_eyebrow", "label": "Sur-titre des définitions", "default": "Comprendre les actions" },
    { "type": "inline_richtext", "id": "definitions_heading", "label": "Titre des définitions", "default": "Planter, régénérer, restaurer : trois réalités." },
    { "type": "text", "id": "planting_title", "label": "Titre plantation", "default": "Plantation" },
    { "type": "textarea", "id": "planting_text", "label": "Définition plantation", "default": "Mise en terre de jeunes plants selon un protocole et un suivi définis." },
    { "type": "text", "id": "regeneration_title", "label": "Titre régénération", "default": "Régénération naturelle" },
    { "type": "textarea", "id": "regeneration_text", "label": "Définition régénération", "default": "Retour de la végétation à partir des graines, rejets et dynamiques déjà présentes." },
    { "type": "text", "id": "restoration_title", "label": "Titre restauration", "default": "Restauration forestière" },
    { "type": "textarea", "id": "restoration_text", "label": "Définition restauration", "default": "Ensemble d’actions adaptées au site pour retrouver des fonctions écologiques durables." },
    { "type": "color", "id": "background", "label": "Arrière-plan", "default": "#FCFAF6" },
    { "type": "color", "id": "panel_color", "label": "Cartes", "default": "#F7F1E6" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#09203F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2F5B43" }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Projet",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Projet à documenter" },
        { "type": "text", "id": "date", "label": "Période", "default": "Période à confirmer" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Ajoutez le lieu, le type d’action, le partenaire opérationnel et les objectifs mesurables.</p>" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Voir le projet" },
        { "type": "checkbox", "id": "is_temporary", "label": "Marquer comme temporaire", "default": true }
      ]
    },
    {
      "type": "payment",
      "name": "Versement",
      "settings": [
        { "type": "text", "id": "title", "label": "Bénéficiaire", "default": "Bénéficiaire à confirmer" },
        { "type": "text", "id": "date", "label": "Date", "default": "Date à confirmer" },
        { "type": "number", "id": "amount_minor", "label": "Montant en unité mineure", "default": 0 },
        { "type": "richtext", "id": "text", "label": "Détail", "default": "<p>Ajoutez la période couverte et la référence du justificatif.</p>" },
        { "type": "url", "id": "link", "label": "Lien vers le justificatif" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Consulter le justificatif" },
        { "type": "checkbox", "id": "is_temporary", "label": "Marquer comme temporaire", "default": true }
      ]
    },
    {
      "type": "document",
      "name": "Justificatif",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Document à publier" },
        { "type": "text", "id": "date", "label": "Date", "default": "Date à confirmer" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Ajoutez la nature du document, son émetteur et la période couverte.</p>" },
        { "type": "url", "id": "link", "label": "Lien vers le document" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Ouvrir le document" },
        { "type": "checkbox", "id": "is_temporary", "label": "Marquer comme temporaire", "default": true }
      ]
    },
    {
      "type": "update",
      "name": "Mise à jour",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Mise à jour à publier" },
        { "type": "text", "id": "date", "label": "Date", "default": "Date à confirmer" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Publiez ici une information factuelle sur l’avancement du projet.</p>" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Lire la mise à jour" },
        { "type": "checkbox", "id": "is_temporary", "label": "Marquer comme temporaire", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Raccoono — Impact",
      "blocks": [
        { "type": "project" },
        { "type": "payment" },
        { "type": "document" },
        { "type": "update" }
      ]
    }
  ]
}
{% endschema %}
