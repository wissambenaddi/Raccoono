{% liquid
  assign profile_count = section.blocks.size
  assign slider_max = profile_count | minus: 1
%}

<raccoono-personality
  class="raccoono-personality"
  data-initial-index="{{ section.settings.initial_index }}"
  style="
    --raccoono-personality-bg: {{ section.settings.background }};
    --raccoono-personality-color: {{ section.settings.text_color }};
    --raccoono-personality-start: {{ section.settings.start_color }};
    --raccoono-personality-end: {{ section.settings.end_color }};
  "
>
  <section
    {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
    class="raccoono-personality__inner"
    aria-labelledby="RaccoonoPersonalityTitle-{{ section.id }}"
  >
    <header class="raccoono-personality__header">
      {% if section.settings.eyebrow != blank %}
        <p class="raccoono-personality__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="RaccoonoPersonalityTitle-{{ section.id }}" class="raccoono-personality__title">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.instruction != blank %}
        <p id="RaccoonoPersonalityHelp-{{ section.id }}" class="raccoono-personality__instruction">
          {{ section.settings.instruction | escape }}
        </p>
      {% endif %}
    </header>

    {% if profile_count > 1 %}
      <div class="raccoono-personality__control">
        <span aria-hidden="true">{{ section.settings.start_label | escape }}</span>
        <input
          class="raccoono-personality__range"
          type="range"
          min="0"
          max="{{ slider_max }}"
          step="1"
          value="{{ section.settings.initial_index }}"
          aria-label="{{ 'blocks.slider_label' | t }}"
          aria-describedby="RaccoonoPersonalityHelp-{{ section.id }}"
        >
        <span aria-hidden="true">{{ section.settings.end_label | escape }}</span>
      </div>
    {% endif %}

    <div class="raccoono-personality__profiles" aria-live="polite">
      {% for block in section.blocks %}
        <article
          class="raccoono-personality__profile"
          data-profile-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="raccoono-personality__visual">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 750px) 42rem, 84vw',
                  loading: 'lazy',
                  class: 'raccoono-personality__image'
              }}
            {% else %}
              {% liquid
                case forloop.index
                  when 1
                    assign default_profile = 'raccoono-profile-calm-v1.webp'
                  when 2
                    assign default_profile = 'raccoono-profile-curious-v1.webp'
                  when 3
                    assign default_profile = 'raccoono-profile-bold-v1.webp'
                  else
                    assign default_profile = 'raccoono-profile-chaos-v1.webp'
                endcase
              %}
              <img
                class="raccoono-personality__image"
                src="{{ default_profile | asset_url }}"
                width="700"
                height="700"
                loading="lazy"
                alt=""
              >
            {% endif %}
          </div>
          <div class="raccoono-personality__copy">
            <p class="raccoono-personality__number" aria-hidden="true">0{{ forloop.index }}</p>
            <h3 class="raccoono-personality__profile-title">{{ block.settings.title | escape }}</h3>
            <p class="raccoono-personality__description">{{ block.settings.description | escape }}</p>
            {% if block.settings.link_label != blank %}
              <a class="raccoono-personality__link" href="{{ block.settings.link }}">
                {{ block.settings.link_label | escape }}
                <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
</raccoono-personality>

{% stylesheet %}
  .raccoono-personality {
    display: block;
    background: var(--raccoono-personality-bg);
    color: var(--raccoono-personality-color);
  }

  .raccoono-personality__inner {
    padding: clamp(6rem, 10vw, 12rem) max(2rem, calc((100vw - 130rem) / 2));
  }

  .raccoono-personality__header {
    max-width: 78rem;
    margin-inline: auto;
    text-align: center;
  }

  .raccoono-personality__eyebrow,
  .raccoono-personality__title,
  .raccoono-personality__instruction {
    margin: 0;
  }

  .raccoono-personality__eyebrow {
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .raccoono-personality__title {
    margin-top: 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(4.2rem, 7vw, 8.6rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .raccoono-personality__instruction {
    max-width: 58ch;
    margin: 1.6rem auto 0;
    font-size: 1.6rem;
  }

  .raccoono-personality__control {
    display: grid;
    grid-template-columns: auto minmax(12rem, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    max-width: 88rem;
    margin: 4rem auto;
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .raccoono-personality__range {
    width: 100%;
    min-height: 4.4rem;
    margin: 0;
    accent-color: var(--raccoono-personality-end);
    cursor: pointer;
  }

  .raccoono-personality__range:focus-visible {
    outline: 0.3rem solid var(--raccoono-personality-end);
    outline-offset: 0.4rem;
  }

  .raccoono-personality__profiles {
    display: grid;
    gap: 2rem;
  }

  .raccoono-personality__profile {
    display: grid;
    grid-template-columns: minmax(26rem, 0.85fr) minmax(28rem, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 9rem);
    max-width: 106rem;
    margin-inline: auto;
    padding: clamp(1.4rem, 3vw, 3rem);
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 3rem;
    background: color-mix(in srgb, var(--raccoono-personality-bg) 86%, white);
  }

  .raccoono-personality.is-ready .raccoono-personality__profile[hidden] {
    display: none;
  }

  .raccoono-personality__visual {
    overflow: hidden;
    border-radius: 2.2rem 2.2rem 2.2rem 0.6rem;
    background: #fff3d9;
  }

  .raccoono-personality__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .raccoono-personality__copy {
    display: grid;
    justify-items: start;
    gap: 1.2rem;
  }

  .raccoono-personality__number {
    margin: 0;
    color: var(--raccoono-personality-end);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .raccoono-personality__profile-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3.4rem, 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .raccoono-personality__description {
    max-width: 46ch;
    margin: 0;
    font-size: 1.7rem;
    line-height: 1.55;
  }

  .raccoono-personality__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    color: inherit;
    font-weight: 750;
    text-decoration-thickness: 0.2rem;
    text-underline-offset: 0.5rem;
  }

  @media (max-width: 749px) {
    .raccoono-personality__control {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      text-align: center;
    }

    .raccoono-personality__profile {
      grid-template-columns: 1fr;
      padding: 1.4rem;
      border-radius: 2.2rem;
    }

    .raccoono-personality__copy {
      padding: 1rem 0.6rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .raccoono-personality__range {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  class RaccoonoPersonality extends HTMLElement {
    connectedCallback() {
      this.range = this.querySelector('input[type="range"]');
      this.profiles = [...this.querySelectorAll('[data-profile-index]')];
      if (!this.range || this.profiles.length < 2) return;
      this.handleInput = () => this.activate(Number(this.range.value));
      this.range.addEventListener('input', this.handleInput);
      const initial = Math.min(Number(this.dataset.initialIndex) || 0, this.profiles.length - 1);
      this.range.value = String(initial);
      this.classList.add('is-ready');
      this.activate(initial);
    }

    disconnectedCallback() {
      this.range?.removeEventListener('input', this.handleInput);
    }

    activate(index) {
      this.profiles.forEach((profile, profileIndex) => {
        profile.hidden = profileIndex !== index;
      });
    }
  }

  if (!customElements.get('raccoono-personality')) {
    customElements.define('raccoono-personality', RaccoonoPersonality);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Raccoono — Personnalité",
  "tag": "section",
  "class": "raccoono-section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Le curseur très scientifique"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Ancre de section",
      "default": "personnalite"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Quel est votre niveau de chaos ?"
    },
    {
      "type": "text",
      "id": "instruction",
      "label": "Instruction",
      "default": "Déplacez le curseur pour révéler votre profil. Contenu de démonstration à personnaliser."
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "Libellé de départ",
      "default": "Mode discret"
    },
    {
      "type": "text",
      "id": "end_label",
      "label": "Libellé de fin",
      "default": "Chaos assumé"
    },
    {
      "type": "range",
      "id": "initial_index",
      "label": "Profil affiché au chargement",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "background",
      "label": "Arrière-plan",
      "default": "#fffaf0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#071a39"
    },
    {
      "type": "color",
      "id": "start_color",
      "label": "Couleur de départ",
      "default": "#0aaec3"
    },
    {
      "type": "color",
      "id": "end_color",
      "label": "Couleur de fin",
      "default": "#f06c56"
    }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Profil",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Profil à personnaliser"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description temporaire à remplacer dans l’éditeur de thème."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Libellé du lien",
          "default": "Voir la sélection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Raccoono — Personnalité",
      "blocks": [
        { "type": "profile", "settings": { "title": "L’observateur tranquille", "description": "Vous aimez les détails qui parlent doucement, mais restent impossibles à oublier." } },
        { "type": "profile", "settings": { "title": "Le curieux bien calibré", "description": "Une touche inattendue suffit à transformer votre tenue et votre humeur." } },
        { "type": "profile", "settings": { "title": "L’audacieux sociable", "description": "Votre style ouvre la conversation avant même que vous ayez dit bonjour." } },
        { "type": "profile", "settings": { "title": "Le chaos magnifique", "description": "Vous ne cherchez pas à passer inaperçu. Franchement, tant mieux." } }
      ]
    }
  ]
}
{% endschema %}
