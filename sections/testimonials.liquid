{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.testimonials.heading' | t
  endif
%}

<section
  class="testimonials section-spacing"
  data-section-id="{{ section.id }}"
  data-section-type="testimonials"
>
  <div class="container container--standard">
    <div class="section-heading section-heading--center">
      <h2>{{ heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    <div class="testimonials__list">
      {% for block in section.blocks %}
        {% liquid
          assign testimonial_text = block.settings.text
          if testimonial_text == blank
            assign testimonial_text = 'sections.testimonials.placeholder_text' | t
          endif

          assign testimonial_author = block.settings.author
          if testimonial_author == blank
            assign testimonial_author = 'sections.testimonials.placeholder_author' | t
          endif
        %}
        {% render 'testimonial-card',
          rating: block.settings.rating,
          text: testimonial_text,
          author: testimonial_author,
          product_title: block.settings.product_title,
          attributes: block.shopify_attributes
        %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Avis",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte de l’avis"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Prénom"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Produit acheté"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
