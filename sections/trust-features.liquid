<section class="trust-features section--compact" style="--trust-bg:{{ section.settings.background }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}<h2 class="sr-only">{{ section.settings.heading }}</h2>{% endif %}
    <div class="trust-features__grid{% if section.settings.mobile_scroll %} scroll-list{% endif %}">
      {% for block in section.blocks %}
        <div class="trust-feature" {{ block.shopify_attributes }}>
          <div class="trust-feature__icon">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 160 | image_tag: width: 64, height: 64, loading: 'lazy', alt: '' }}
            {% else %}
              {% render 'icon', name: block.settings.icon %}
            {% endif %}
          </div>
          <div>
            <h3>{{ block.settings.heading }}</h3>
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .trust-features{background:var(--trust-bg)}
  .trust-features__grid{display:grid;gap:1rem}
  .trust-feature{display:flex;align-items:center;gap:1rem;padding:1rem}
  .trust-feature__icon{display:grid;width:64px;height:64px;flex:0 0 64px;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--color-accent-secondary) 25%,transparent)}
  .trust-feature__icon svg{width:30px}
  .trust-feature h3{margin:0;font-size:1rem}
  .trust-feature p{margin:.2rem 0 0;color:var(--color-muted);font-size:.85rem}
  @media(min-width:750px){.trust-features__grid{grid-template-columns:repeat(4,1fr)}}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust features",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Accessible heading", "default": "Why shop with us" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFDF7" },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Horizontal scroll on mobile", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "package", "label": "Package" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fast dispatch" },
        { "type": "text", "id": "text", "label": "Text", "default": "Replace with verified details" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "heading": "Fast dispatch" } },
        { "type": "feature", "settings": { "icon": "heart", "heading": "Made with personality" } },
        { "type": "feature", "settings": { "icon": "package", "heading": "Careful packaging" } },
        { "type": "feature", "settings": { "icon": "leaf", "heading": "Clear material details" } }
      ]
    }
  ]
}
{% endschema %}
