{% doc %}
Renders a collection card using a collection resource or manual fallback content.

@param {collection} [collection] - Shopify collection.
@param {image} [image] - Manual fallback image.
@param {string} [title] - Manual fallback title.
@param {string} [url] - Manual fallback URL.
@param {number} [placeholder_index] - Placeholder number from 1 to 6.
@param {string} [attributes] - Shopify editor attributes.
{% enddoc %}

{% liquid
  assign card_image = image
  assign card_title = title
  assign card_url = url

  if collection != blank
    assign card_image = collection.image
    assign card_title = collection.title
    assign card_url = collection.url
  endif

  if card_title == blank
    assign card_title = 'sections.collections.placeholder_title' | t
  endif

  assign resolved_placeholder_index = placeholder_index | default: 1
  assign placeholder_name = 'collection-' | append: resolved_placeholder_index
%}

<article class="collection-card" {{ attributes }}>
  <a
    class="collection-card__link"
    {% if card_url != blank %}
      href="{{ card_url }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >
    <div class="collection-card__media">
      {% if card_image != blank %}
        {{
          card_image
          | image_url: width: 1400
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1400',
            sizes: '(min-width: 990px) 33vw, 78vw',
            loading: 'lazy',
            class: 'collection-card__image',
            alt: card_image.alt
        }}
      {% else %}
        {{ placeholder_name | placeholder_svg_tag: 'collection-card__placeholder' }}
      {% endif %}
    </div>
    <div class="collection-card__content">
      <h3>{{ card_title | escape }}</h3>
      <span>{{ 'sections.collections.discover' | t }}</span>
    </div>
  </a>
</article>
