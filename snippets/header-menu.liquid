{% doc %}
Renders the compact desktop navigation with one level of native submenus.

@param {linklist} menu - Shopify navigation menu.
{% enddoc %}

{% if menu != blank %}
  <nav class="header-menu" aria-label="{{ 'sections.header.primary_navigation' | t }}">
    <ul class="header-menu__list" role="list">
      {% for link in menu.links limit: 4 %}
        {% liquid
          case forloop.index
            when 1
              assign link_label = 'sections.header.navigation.shop' | t
            when 2
              assign link_label = 'sections.header.navigation.best_sellers' | t
            when 3
              assign link_label = 'sections.header.navigation.about' | t
            when 4
              assign link_label = 'sections.header.navigation.mission' | t
          endcase
        %}
        <li class="header-menu__item">
          {% if link.links != blank %}
            <details class="header-menu__details">
              <summary class="header-menu__summary">
                <span>{{ link_label | escape }}</span>
                {% render 'icon', name: 'chevron-down', size: 14 %}
              </summary>
              <ul class="header-menu__submenu" role="list">
                {% for child_link in link.links %}
                  <li>
                    <a href="{{ child_link.url }}" {% if child_link.current %}aria-current="page"{% endif %}>
                      {{ child_link.title | escape }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% else %}
            <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
              {{ link_label | escape }}
            </a>
          {% endif %}
        </li>
      {% endfor %}
      <li class="header-menu__item">
        <a href="{{ routes.root_url }}pages/contact">
          {{ 'sections.header.navigation.contact' | t }}
        </a>
      </li>
    </ul>
  </nav>
{% endif %}
