{% doc %}
Renders an inline icon from the controlled Raccoono icon set.

@param {string} name - Icon name.
@param {number} [size] - Icon size in pixels.
@param {string} [class] - Additional CSS class.
@param {string} [title] - Accessible name when the icon conveys information.
{% enddoc %}

{% liquid
  assign icon_size = size | default: 20
  assign icon_class = 'icon icon--' | append: name
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
%}

<svg
  class="{{ icon_class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  focusable="false"
  {% if title != blank %}
    role="img"
    aria-label="{{ title | escape }}"
  {% else %}
    aria-hidden="true"
  {% endif %}
>
  {% if title != blank %}
    <title>{{ title | escape }}</title>
  {% endif %}

  {% case name %}
    {% when 'arrow-right' %}
      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'check' %}
      <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'chevron-down' %}
      <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'close' %}
      <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    {% when 'info' %}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
      <path d="M12 11v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      <circle cx="12" cy="8" r="1" fill="currentColor"/>
    {% when 'warning' %}
      <path d="M12 3 2.8 20h18.4L12 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
      <path d="M12 9v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      <circle cx="12" cy="17" r="1" fill="currentColor"/>
    {% when 'image' %}
      <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.75"/>
      <circle cx="8.5" cy="9" r="1.5" fill="currentColor"/>
      <path d="m5 18 5-5 3 3 2-2 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'menu' %}
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    {% when 'search' %}
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75"/>
      <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    {% when 'account' %}
      <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.75"/>
      <path d="M5 20c.7-4 3-6 7-6s6.3 2 7 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    {% when 'raccoon-account' %}
      <path d="m7.1 6.2-2.6-2 .2 4.6M16.9 6.2l2.6-2-.2 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M5.2 10.1c.5-3.1 2.9-5 6.8-5s6.3 1.9 6.8 5c.7 4.2-1.3 8.7-6.8 9.8-5.5-1.1-7.5-5.6-6.8-9.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M6.2 10.7c1.7-1.9 3.6-2.2 5.8-.8 2.2-1.4 4.1-1.1 5.8.8-1 2.1-2.9 3.1-5.8 2.4-2.9.7-4.8-.3-5.8-2.4Z" fill="currentColor"/>
      <circle cx="9.2" cy="10.8" r=".85" fill="white"/>
      <circle cx="14.8" cy="10.8" r=".85" fill="white"/>
      <path d="M10.2 15.2c.5-.6 1.1-.9 1.8-.9s1.3.3 1.8.9c-.4 1-1 1.5-1.8 1.5s-1.4-.5-1.8-1.5Z" fill="currentColor"/>
    {% when 'cart' %}
      <path d="M4 5h2l1.5 9h9.8l1.7-6H7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9" cy="18.5" r="1.25" fill="currentColor"/>
      <circle cx="17" cy="18.5" r="1.25" fill="currentColor"/>
    {% when 'backpack' %}
      <path d="M8.5 7V5.8A3.1 3.1 0 0 1 12 3a3.1 3.1 0 0 1 3.5 2.8V7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      <path d="M7.2 6.8h9.6c1.2 0 2.2 1 2.2 2.2v10.2c0 1-.8 1.8-1.8 1.8H6.8c-1 0-1.8-.8-1.8-1.8V9c0-1.2 1-2.2 2.2-2.2Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
      <path d="M5 11.2H3.8v5.6H5M19 11.2h1.2v5.6H19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8.2 14h7.6v5H8.2zM9 10.2h6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'instagram' %}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.75"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.75"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
    {% when 'facebook' %}
      <path d="M14 21v-8h3l.5-3H14V8.3c0-1 .4-1.8 1.9-1.8H18V3.8c-.7-.1-1.5-.3-2.6-.3-2.7 0-4.4 1.6-4.4 4.6V10H8v3h3v8h3Z" fill="currentColor"/>
    {% when 'tiktok' %}
      <path d="M14 4c.5 2.4 1.8 3.8 4 4v3c-1.5 0-2.8-.5-4-1.3v5.8A5.5 5.5 0 1 1 9 10v3.1a2.5 2.5 0 1 0 2 2.4V4h3Z" fill="currentColor"/>
    {% else %}
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.75"/>
  {% endcase %}
</svg>
