{% doc %}
Renders a progressively enhanced mobile menu drawer based on native details elements.

@param {linklist} menu - Shopify navigation menu.
@param {string} section_id - Parent header section ID.
{% enddoc %}

<details class="mobile-menu" data-mobile-menu>
  <summary class="header-action mobile-menu__toggle" aria-label="{{ 'sections.header.open_menu' | t }}">
    {% render 'icon', name: 'menu', size: 26 %}
  </summary>

  <div class="mobile-menu__overlay" data-menu-close-area></div>
  <div
    class="mobile-menu__drawer"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.header.mobile_navigation' | t }}"
    id="MobileMenu-{{ section_id }}"
  >
    <div class="mobile-menu__top">
      <span class="mobile-menu__title">{{ 'sections.header.menu' | t }}</span>
      <button class="header-action mobile-menu__close" type="button" data-menu-close>
        {% render 'icon', name: 'close', size: 26 %}
        <span class="visually-hidden">{{ 'sections.header.close_menu' | t }}</span>
      </button>
    </div>

    {% if menu != blank %}
      <nav aria-label="{{ 'sections.header.mobile_navigation' | t }}">
        <ul class="mobile-menu__list" role="list">
          {% for link in menu.links %}
            <li>
              {% if link.links != blank %}
                <details class="mobile-menu__nested">
                  <summary class="{% if link.current or link.child_active %}mobile-menu__summary--active{% endif %}">
                    <span>{{ link.title | escape }}</span>
                    {% render 'icon', name: 'chevron-down', size: 16 %}
                  </summary>
                  <ul role="list">
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" {% if child_link.current %}aria-current="page"{% endif %}>
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                  {{ link.title | escape }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</details>
