{% doc %}
Renders accessible pagination controls.

@param {paginate} paginate - Shopify paginate object.
{% enddoc %}

{% if paginate.pages > 1 %}
  {% assign current_page_label = paginate.current_page | append: '' %}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    {% if paginate.previous %}
      <a class="pagination__direction" href="{{ paginate.previous.url }}">
        {{ 'general.pagination.previous' | t }}
      </a>
    {% endif %}

    <ol class="pagination__list" role="list">
      {% for part in paginate.parts %}
        <li>
          {% if part.is_link %}
            <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
              {{ part.title }}
            </a>
          {% else %}
            <span
              {% if part.title == current_page_label %}
                aria-current="page"
              {% endif %}
            >
              {{ part.title }}
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>

    {% if paginate.next %}
      <a class="pagination__direction" href="{{ paginate.next.url }}">
        {{ 'general.pagination.next' | t }}
      </a>
    {% endif %}
  </nav>
{% endif %}
