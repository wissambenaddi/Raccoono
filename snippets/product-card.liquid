{% doc %}
Renders a lightweight product card without quick view or Ajax behavior.

@param {product} [product] - Product to render.
@param {number} [placeholder_index] - Placeholder number from 1 to 6.
@param {boolean} [show_badges] - Shows sale and sold-out badges.
@param {string} [class] - Additional CSS class.
{% enddoc %}

{% liquid
  assign card_class = 'product-card'
  if class != blank
    assign card_class = card_class | append: ' ' | append: class
  endif

  assign resolved_placeholder_index = placeholder_index | default: 1
  assign placeholder_name = 'product-' | append: resolved_placeholder_index
  assign sold_out_label = 'products.product.sold_out' | t
  assign sale_label = 'products.product.sale' | t
%}

<article class="{{ card_class }}">
  <a
    class="product-card__media"
    {% if product != blank %}
      href="{{ product.url }}"
      aria-label="{{ product.title | escape }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >
    {% if product != blank and product.featured_image != blank %}
      {{
        product.featured_image
        | image_url: width: 1200
        | image_tag:
          widths: '320, 480, 640, 800, 960, 1200',
          sizes: '(min-width: 990px) 33vw, 50vw',
          loading: 'lazy',
          class: 'product-card__image',
          alt: product.featured_image.alt
      }}
    {% else %}
      {{ placeholder_name | placeholder_svg_tag: 'product-card__placeholder' }}
    {% endif %}

    {% if show_badges and product != blank %}
      <span class="product-card__badges">
        {% unless product.available %}
          {% render 'badge', label: sold_out_label, variant: 'sold-out' %}
        {% else %}
          {% if product.compare_at_price_max > product.price %}
            {% render 'badge', label: sale_label, variant: 'sale' %}
          {% endif %}
        {% endunless %}
      </span>
    {% endif %}
  </a>

  <div class="product-card__content">
    {% if product != blank %}
      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>
      {% render 'price', product: product %}
    {% else %}
      <h3 class="product-card__title">{{ 'products.product.placeholder' | t }}</h3>
      <span class="product-card__placeholder-price">{{ 'products.price.placeholder' | t }}</span>
    {% endif %}
  </div>
</article>
