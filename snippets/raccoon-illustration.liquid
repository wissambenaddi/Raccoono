{% doc %}
Renders a contextual raccoon illustration without fixing it to a page or section.

@param {image} [image] - Optional merchant-selected illustration.
@param {string} [alt] - Alternative text when informative.
@param {boolean} [decorative] - Marks the illustration as decorative.
@param {string} [size] - micro, small, medium or large.
@param {string} [position] - start, center or end.
@param {string} [expression] - Contextual expression identifier.
@param {string} [loading] - lazy or eager.
@param {string} [class] - Additional CSS class.
@param {string} [caption] - Optional visible caption.
{% enddoc %}

{% liquid
  assign illustration_size = size | default: 'small'
  assign illustration_position = position | default: 'center'
  assign illustration_expression = expression | default: 'calm'
  assign resolved_loading = loading | default: 'lazy'
  assign is_decorative = true

  if decorative == false
    assign is_decorative = false
  endif

  if caption != blank
    assign is_decorative = false
  endif

  assign resolved_alt = alt | default: ''
  if is_decorative == false and resolved_alt == blank
    assign resolved_alt = 'accessibility.raccoon_illustration' | t
  endif

  assign illustration_class = 'raccoon-illustration raccoon-illustration--' | append: illustration_size
  assign illustration_class = illustration_class | append: ' raccoon-illustration--' | append: illustration_position

  if class != blank
    assign illustration_class = illustration_class | append: ' ' | append: class
  endif
%}

<figure
  class="{{ illustration_class }}"
  data-raccoon-expression="{{ illustration_expression | escape }}"
  {% if is_decorative %}
    aria-hidden="true"
  {% endif %}
>
  {% if image != blank %}
    {% render 'responsive-image',
      image: image,
      alt: resolved_alt,
      widths: '96, 160, 240, 320, 480, 640',
      sizes: '(min-width: 750px) 260px, 110px',
      loading: resolved_loading,
      aspect_ratio: '1 / 1'
    %}
  {% else %}
    <img
      src="{{ 'raccoono-placeholder.svg' | asset_url }}"
      alt="{{ resolved_alt | escape }}"
      width="640"
      height="640"
      loading="{{ resolved_loading }}"
    >
  {% endif %}

  {% if caption != blank %}
    <figcaption>{{ caption }}</figcaption>
  {% endif %}
</figure>
